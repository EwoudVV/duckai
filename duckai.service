[Unit]
Description=duckai web (nest, no local runner)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/duckai
EnvironmentFile=%h/duckai/.env
ExecStart=%h/duckai/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
